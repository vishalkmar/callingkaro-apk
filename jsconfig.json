{
  "compilerOptions": {
    "baseUrl": "./src",
    "jsx": "react-native",
    "paths": {
      "@app/*": ["app/*"],
      "@components/*": ["components/*"],
      "@screens/*": ["screens/*"],
      "@navigation/*": ["navigation/*"],
      "@services/*": ["services/*"],
      "@store/*": ["store/*"],
      "@utils/*": ["utils/*"],
      "@theme": ["theme/index.js"],
      "@theme/*": ["theme/*"],
      "@db/*": ["db/*"],
      "@hooks/*": ["hooks/*"],
      "@constants/*": ["constants/*"],
      "@assets/*": ["assets/*"],
      "@i18n": ["i18n/index.js"]
    }
  },
  "exclude": ["node_modules", "android", "ios"]
}
